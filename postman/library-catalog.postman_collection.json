    {
      "name": "Books",
      "item": [
        {
          "name": "List books with combined filters",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/books?genre={{genreId}}&search=dune&page=2&limit=5",
              "host": ["{{baseUrl}}"],
              "path": ["books"],
              "query": [
                { "key": "genre", "value": "{{genreId}}" },
                { "key": "search", "value": "dune" },
                { "key": "page", "value": "2" },
                { "key": "limit", "value": "5" }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Create book",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"The Quiet Orbit\",\n  \"author\": \"Mara Voss\",\n  \"isbn\": \"9780306406157\",\n  \"description\": \"A navigation engineer follows a signal beyond the edge of a settled star system.\",\n  \"coverImage\": \"https://example.com/quiet-orbit.jpg\",\n  \"totalCopies\": 8,\n  \"availableCopies\": 6,\n  \"genre\": \"{{genreId}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/books"
          },
          "response": []
        },
        {
          "name": "Create book with empty body (validation example)",
